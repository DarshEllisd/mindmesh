# Google AI Studio key (https://aistudio.google.com/apikey). Used for Gemma 4 and, by default, embeddings.
GEMINI_API_KEY=
# Gemma 4 model id on the Gemini API (the other size is used as a fallback). Check ids at /api/models.
# GEMMA_THINKING=minimal keeps it fast; use "high" for deeper reasoning.
GEMMA_MODEL=gemma-4-26b-a4b-it
# "gemini" (default) or "hf" to use open-weight EmbeddingGemma through Hugging Face Inference.
EMBED_PROVIDER=gemini
HF_TOKEN=
# Optional, no scopes needed. Raises the GitHub API rate limit for Repo mode.
GITHUB_TOKEN=
